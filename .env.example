# Asirive Copartner — Environment Variables
# Copy this to .env and fill in your keys. Never commit .env to Git.

# ── Gemini (Primary Brain) ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenCode Go (Cheap open-source fallback models) ───────────────────────────
# Get your key at https://opencode.ai/auth
# $10/month flat — GLM-5, Kimi K2, Qwen, DeepSeek, MiMo, etc.
OPENCODE_API_KEY=your_opencode_go_key_here
OPENCODE_BASE_URL=https://go.opencode.ai/v1

# ── Stripe (Client invoicing & payments) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# ── Vercel (Frontend deployment) ──────────────────────────────────────────────
VERCEL_TOKEN=your_vercel_token_here
VERCEL_TEAM_ID=                          # Optional — leave blank for personal accounts

# ── Optional integrations ─────────────────────────────────────────────────────
# GITHUB_TOKEN=your_github_personal_access_token
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_anon_key

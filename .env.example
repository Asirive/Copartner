# Asirive Copartner - Environment Configuration Template

# 1. Brain: Gemini API Key (Mandatory)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Payments & Agency Operations: Stripe API Keys (Mandatory for Phase 5)
# Obtain from: https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# 3. IPC & Application Settings
IPC_PORT=8080
LOG_LEVEL=INFO
DEBUG=true

# 4. External Services (Optional / Deferred)
VERCEL_AUTH_TOKEN=
BRAVE_SEARCH_API_KEY=
GITHUB_TOKEN=

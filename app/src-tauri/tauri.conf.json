{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copartner",
  "version": "0.1.0",
  "identifier": "com.asirive.copartner",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Copartner",
        "width": 1920,
        "height": 40,
        "minWidth": 400,
        "minHeight": 6,
        "maxHeight": 800,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "visible": true,
        "center": false,
        "x": 0,
        "y": 0,
        "shadow": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
